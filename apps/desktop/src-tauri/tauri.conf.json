{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoriSori Desktop",
  "version": "0.1.0",
  "identifier": "com.sorisori.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SoriSori Desktop",
        "width": 1180,
        "height": 820,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
