# Local AI service (로컬 오픈소스 STT/번역)
# 이 값이 있으면 OpenAI/DeepL 대신 로컬 faster-whisper + argostranslate 사용
LOCAL_AI_URL=http://127.0.0.1:8789
LOCAL_AI_HOST=127.0.0.1
LOCAL_AI_PORT=8789
WHISPER_MODEL=base
WHISPER_DEVICE=auto

# Realtime providers (LOCAL_AI_URL 없을 때 fallback)
OPENAI_API_KEY=
OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_REALTIME_BASE_URL=wss://api.openai.com/v1/realtime
OPENAI_REALTIME_LANGUAGE=
OPENAI_REALTIME_TRANSCRIPTION_PROMPT=
DEEPL_API_KEY=

# Realtime gateway
REALTIME_HOST=127.0.0.1
REALTIME_PORT=8787

# Pipeline service
PIPELINE_HOST=127.0.0.1
PIPELINE_PORT=8788
REALTIME_GATEWAY_WS_URL=ws://127.0.0.1:8787/ws
PIPELINE_SESSION_IDS=mvp-session-001
DATABASE_URL=postgresql://sorisori:sorisori@localhost:5432/sorisori

# Web app
PIPELINE_API_URL=http://127.0.0.1:8788
NEXT_PUBLIC_REALTIME_WS_URL=ws://127.0.0.1:8787/ws
NEXT_PUBLIC_DEFAULT_SESSION_ID=mvp-session-001
